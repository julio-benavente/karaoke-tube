    "test": "vitest run"
  },
  "dependencies": {
    "@karaoke-tube/shared": "workspace:*",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^4.1.12"
  }
}
