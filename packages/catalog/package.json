{
  "name": "@karaoke-tube/catalog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./build": "./src/build.ts"
  },
  "scripts": {
