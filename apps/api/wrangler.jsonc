{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karaoke-tube",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The guest web app (apps/web) is built into ../web/dist and served by this same Worker.
  // Requests to /api/* always hit the Worker first; everything else is a static file or the SPA.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // One Durable Object instance per karaoke room (live queue, members, websockets).
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  // YouTube search results (7 days) and video details (30 days). Wrangler creates the namespace on first deploy.
  "kv_namespaces": [{ "binding": "SEARCH_CACHE" }],

  // Per-IP limits on room lookups/joins (code guessing) and room creation.
  "ratelimits": [
    { "name": "ROOM_LOOKUP_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "ROOM_CREATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],

  "observability": { "enabled": true }
}
