{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karaoke-tube",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The guest web app (apps/web) is built into ../web/dist and served by this same Worker.
  // Requests to /api/* always hit the Worker first; everything else is a static file or the SPA.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // One Durable Object instance per karaoke room (live queue, members, websockets).
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  "observability": { "enabled": true }
}
