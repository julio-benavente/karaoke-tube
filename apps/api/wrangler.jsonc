{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karaoke-tube",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Keep the workers.dev address on. (Cloudflare turns it off by default as soon as a Worker has custom routes.)
  "workers_dev": true,
  // Our own domain: Cloudflare creates the DNS records and certificates on deploy (the zone is in this account).
  // The zone must have no other A/AAAA/CNAME records on these names (e.g. registrar parking pages), or the deploy fails.
  "routes": [
    { "pattern": "karaokeetube.com", "custom_domain": true },
    { "pattern": "www.karaokeetube.com", "custom_domain": true }
  ],

  // The guest web app (apps/web) is built into ../web/dist and served by this same Worker.
  // Requests to /api/* always hit the Worker first; everything else is a static file or the SPA.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // One Durable Object instance per karaoke room (live queue, members, websockets).
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      // TV pairing codes: one instance for the whole app.
      { "name": "PAIRING", "class_name": "Pairing" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Pairing"] }
  ],

  // YouTube search results (7 days) and video details (30 days). Wrangler creates the namespace on first deploy.
  // RECAPS: end-of-night recaps, readable at /recap/:id for 30 days.
  "kv_namespaces": [{ "binding": "SEARCH_CACHE" }, { "binding": "RECAPS" }],

  // Optional accounts: users, sessions, favorites, friends and the party log. Guests never touch it.
  "d1_databases": [{ "binding": "DB" }],

  // Per-IP limits on room lookups/joins (code guessing) and room creation.
  "ratelimits": [
    { "name": "ROOM_LOOKUP_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "ROOM_CREATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "CLIENT_ERROR_LIMITER", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } }
  ],

  // Long-lived event data (3 months, SQL-queryable). See src/log.ts for the columns.
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "karaoke_tube_events" }],

  "observability": { "enabled": true }
}
